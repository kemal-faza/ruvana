# Builder seed Modul 4: image one-shot yang menjalankan migrasi + seed otomatis
# saat `docker compose up -d`. Data seed idempoten sehingga aman dijalankan
# berulang (termasuk setelah volume db di-reset).

FROM node:22-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# prisma.config.ts mewajibkan DATABASE_URL saat memuat konfigurasi (termasuk
# saat generate). Nilai placeholder hanya untuk lapisan build; environment
# `db-init` di docker-compose menimpanya pada saat runtime.
ENV DATABASE_URL=postgresql://build:build@localhost:5432/build
WORKDIR /seed

COPY package.json pnpm-lock.yaml prisma.config.ts ./
COPY prisma ./prisma

RUN npm install -g pnpm@10.30.2 \
  && pnpm install --frozen-lockfile \
  && pnpm prisma generate

CMD ["sh", "-c", "pnpm prisma migrate deploy && pnpm prisma db seed"]