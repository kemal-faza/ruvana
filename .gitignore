# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# pnpm satu-satunya package manager (lihat "packageManager" di package.json).
# Lockfile npm/yarn jangan dibuat — CI memakai pnpm install --frozen-lockfile.
package-lock.json
yarn.lock

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

CLAUDE.md

# Dokumentasi lokal di-ignore secara default. Hanya artefak kontrak tim berikut
# yang dilacak; direktori induk harus di-unignore agar negasi file bekerja.
/docs/*
!/docs/PRD.md
!/docs/DESIGN.md
!/docs/api/
/docs/api/*
!/docs/api/openapi.yaml
!/docs/superpowers/
/docs/superpowers/*
!/docs/DECISION.md

*.pdf
*.sql

# --- generated prisma client (tidak di-commit) ---
generated/

# --- compose lokal khusus mesin pengembang (jangan di-commit) ---
docker-compose.local.yml
docker-compose.override.yml

# --- pengecualian agar template & migrasi ikut ter-commit ---
!.env.example
!prisma/migrations/**/*.sql
!docker/postgres-init/**/*.sql

.codegraph/
.worktrees/
.superpowers/
figma/
docker/

output/
.vitest/
