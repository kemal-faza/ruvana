# Database (PostgreSQL via Docker Compose) — salin ke .env dan sesuaikan
POSTGRES_DB=ruvana
POSTGRES_USER=ruvana
POSTGRES_PASSWORD=ruvana_pass
POSTGRES_PORT=5432

# Dipakai Prisma (prisma.config.ts) & aplikasi
DATABASE_URL="postgresql://ruvana:ruvana_pass@localhost:5432/ruvana"

# URL publik untuk metadata SEO, sitemap, dan robots
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret untuk cron pembersihan reservasi kedaluwarsa (TASK 3.6).
# Di Vercel, set juga sebagai Environment Variable dengan nama yang sama;
# Vercel Cron otomatis mengirimnya sebagai header Authorization Bearer.
CRON_SECRET="isi-dengan-string-acak-minimal-32-karakter"
