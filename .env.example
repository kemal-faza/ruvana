# Database (PostgreSQL via Docker Compose) — salin ke .env dan sesuaikan
POSTGRES_DB=ruvana
POSTGRES_USER=ruvana
POSTGRES_PASSWORD=ruvana_pass
POSTGRES_PORT=5432

# Dipakai Prisma (prisma.config.ts) & aplikasi
DATABASE_URL="postgresql://ruvana:ruvana_pass@localhost:5432/ruvana"

# Wajib untuk seed demo lokal; pilih nilai unik 16–72 byte. Jangan commit nilainya.
SEED_DEMO_PASSWORD=

# URL publik untuk metadata SEO, sitemap, dan robots
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Local Blob access; simpan kredensial aktual di .env.local.
BLOB_READ_WRITE_TOKEN=

# Vercel Cron: isi dengan nilai acak panjang pada environment Production.
# Vercel mengirim Authorization: Bearer <CRON_SECRET> saat job dijalankan.
CRON_SECRET=
