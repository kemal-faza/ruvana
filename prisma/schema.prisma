generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  pengguna
  petugas
  admin
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  DISABLED
}

model User {
  id              Int           @id @default(autoincrement())
  nama            String        @db.VarChar(100)
  email           String        @unique @db.VarChar(254)
  password        String
  role            Role          @default(pengguna)
  status          AccountStatus @default(PENDING)
  dibuatOleh      Int?
  waktuDaftar     DateTime      @default(now())
  waktuVerifikasi DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  reservations          Reservation[]
  reports               Report[]
  sessions              Session[]
  facilityStatusChanges Facility[]    @relation("FacilityStatusChangedBy")
  facilityArchives      Facility[]    @relation("FacilityDeletedBy")

  @@map("users")
}

model Session {
  tokenHash String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  key       String   @id
  failures  Int      @default(0)
  windowAt  DateTime @db.Timestamptz(3)

  @@map("login_attempts")
}

enum TipeFasilitas {
  ruang_kelas
  aula
  laboratorium
  alat
  lapangan
}

enum StatusFasilitas {
  ACTIVE
  UNDER_MAINTENANCE
  INACTIVE
}

model Facility {
  id                Int             @id @default(autoincrement())
  nama              String          @unique
  tipe              TipeFasilitas
  lokasi            String
  kapasitas         Int
  deskripsi         String?
  // Foto unggahan admin (FAC-05): pathname private Vercel Blob + metadata.
  foto              String?         @unique(map: "facilities_foto_key")
  fotoContentType   String?
  fotoSize          Int?
  status            StatusFasilitas @default(ACTIVE)
  // Provenance status terbaru (PRD Bagian 10, REP-04): aktor + satu instant server.
  statusChangedAt   DateTime?       @db.Timestamptz(3)
  statusChangedBy   User?           @relation("FacilityStatusChangedBy", fields: [statusChangedById], references: [id])
  statusChangedById Int?
  // Arsip (soft delete FAC-05): baris tetap ada agar bisa dipulihkan.
  // deletedByNama disimpan agar riwayat tetap terbaca bila akun admin dihapus.
  deletedAt         DateTime?       @db.Timestamptz(3)
  deletedBy         User?           @relation("FacilityDeletedBy", fields: [deletedById], references: [id])
  deletedById       Int?
  deletedByNama     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  reservations Reservation[]
  reports      Report[]

  @@map("facilities")
}

enum StatusReservasi {
  PENDING
  APPROVED
  REJECTED
  CANCELLED_BY_USER
  CANCELLED_BY_OFFICER
  EXPIRED
}

model Reservation {
  id               Int            @id @default(autoincrement())
  user             User           @relation(fields: [userId], references: [id])
  userId           Int
  facility         Facility       @relation(fields: [facilityId], references: [id])
  facilityId       Int
  // Tanggal kalender Asia/Jakarta (PRD Bagian 8 & 10): PostgreSQL DATE.
  tanggal          DateTime       @db.Date
  // Instant absolut (UTC) untuk mulai/selesai (PRD): TIMESTAMPTZ.
  startTime        DateTime       @db.Timestamptz(3)
  endTime          DateTime       @db.Timestamptz(3)
  tujuanPenggunaan String
  status           StatusReservasi @default(PENDING)
  alasan           String?
  diprosesOleh     Int?
  waktuDiproses    DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  @@index([facilityId, tanggal, startTime, status])
  @@map("reservations")
}

enum StatusLaporan {
  NEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

model Report {
  id              Int           @id @default(autoincrement())
  user            User          @relation(fields: [userId], references: [id])
  userId          Int
  facility        Facility      @relation(fields: [facilityId], references: [id])
  facilityId      Int
  kategori        String
  deskripsi       String
  foto            String?       @unique(map: "reports_foto_key")
  fotoContentType String?
  fotoSize        Int?
  status          StatusLaporan @default(NEW)
  catatanResolusi String?
  ditanganiOleh   Int?
  // Waktu pemrosesan oleh petugas (REP-03); satu instant server per transisi.
  waktuDiproses   DateTime?     @db.Timestamptz(3)
  // Instant absolut (UTC) untuk batas hari analitik Asia/Jakarta.
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt, id])
  @@map("reports")
}

model ReportUploadRateLimit {
  key             String   @id @db.VarChar(80)
  windowStartedAt DateTime @db.Timestamptz(3)
  requestCount    Int      @default(0)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@index([updatedAt])
  @@map("report_upload_rate_limits")
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String
  principalId  Int
  scope        String
  requestHash  String
  responseStatus Int?
  responseBody Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([key, principalId, scope])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
